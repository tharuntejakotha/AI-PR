pipeline {
    agent any

    stages {

        // Multibranch / GitHub: use SCM from the job (PR branch). Avoid hardcoded branch so PR builds get CHANGE_ID.
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                bat '.\\mvnw.cmd clean install'
            }
        }

        // POC: integrate Checkmarx output as text. Replace this stage with Checkmarx CLI/plugin; write findings to checkmarx_input.txt.
        stage('Prepare Checkmarx findings') {
            steps {
                script {
                    def wrote = false
                    try {
                        withCredentials([string(credentialsId: 'checkmarx-output', variable: 'CX_TEXT')]) {
                            def text = (env.CX_TEXT ?: '').trim()
                            if (text) {
                                writeFile file: 'checkmarx_input.txt', text: env.CX_TEXT
                                wrote = true
                            }
                        }
                    } catch (Exception e) {
                        echo "Optional credential 'checkmarx-output' not used (${e.message}). Using repo sample or empty-handling below."
                    }
                    if (!wrote) {
                        powershell encoding: 'UTF-8', script: """
                            Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force
                            Set-Location -LiteralPath '${env.WORKSPACE.replace("'", "''")}'
                            Copy-Item -LiteralPath 'checkmarx-poc/sample-findings.txt' -Destination 'checkmarx_input.txt' -Force
                        """
                    }
                }
            }
        }

        stage('Checkmarx scan') {
            steps {
                echo 'POC placeholder: run your Checkmarx scan here (plugin/CLI). On completion, write or update checkmarx_input.txt with the error/findings export.'
            }
        }

        // Minimum agreed flow: Checkmarx-style payload -> OpenAI -> comment on the same PR (requires PR-detected build + credentials).
        stage('AI PR comment from Checkmarx') {
            steps {
                script {
                    def githubOwner = 'tharuntejakotha'
                    def githubRepo = 'AI-PR'
                    def prNumber = (env.CHANGE_ID ?: env.ghprbPullId ?: '').trim()

                    def branch = (env.BRANCH_NAME ?: env.GIT_BRANCH ?: '').trim()
                    if (branch.startsWith('origin/')) {
                        branch = branch.substring('origin/'.length())
                    }

                    if (!prNumber && branch) {
                        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                            withEnv(["BRANCH_FOR_PR_RESOLVE=${branch}"]) {
                                prNumber = powershell(
                                    encoding: 'UTF-8',
                                    returnStdout: true,
                                    script: """
                                        Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force
                                        Set-Location -LiteralPath '${env.WORKSPACE.replace("'", "''")}'
                                        .\\scripts\\resolve_pr_number.ps1 -Owner '${githubOwner}' -Repo '${githubRepo}'
                                    """
                                ).trim()
                            }
                        }
                    }

                    if (!prNumber) {
                        echo 'Skipped AI PR comment: not a PR build (no CHANGE_ID/ghprbPullId and could not resolve PR from branch). Use a Multibranch Pipeline or GitHub PR trigger.'
                        return
                    }

                    withCredentials([string(credentialsId: 'openai-api-key', variable: 'OPENAI_API_KEY')]) {
                        withEnv(['OPENAI_MODEL=gpt-4.1-mini']) {
                            try {
                                powershell encoding: 'UTF-8', script: """
                                    Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force
                                    Set-Location -LiteralPath '${env.WORKSPACE.replace("'", "''")}'
                                    .\\scripts\\run_checkmarx_ai_jenkins.ps1 -InputFile 'checkmarx_input.txt'
                                """
                            } catch (e) {
                                echo "OpenAI / Python step failed (no PR comment): ${e}"
                                throw e
                            }
                        }
                    }

                    try {
                        echo "GitHub PR comment step: GIT_COMMIT=${env.GIT_COMMIT} (must include fixed github_post_comment.ps1; log should show 'HttpClient + manual JSON' banner)."
                        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                            powershell encoding: 'UTF-8', script: """
                                Set-ExecutionPolicy -Scope Process -ExecutionPolicy Bypass -Force
                                Set-Location -LiteralPath '${env.WORKSPACE.replace("'", "''")}'
                                .\\scripts\\github_post_comment.ps1 -Owner '${githubOwner}' -Repo '${githubRepo}' -PrNumber ${prNumber}
                            """
                        }
                    } catch (e) {
                        echo "GitHub PR comment failed: ${e}"
                    }
                }
            }
        }

        // Runs after Checkmarx/AI path so a missing local Sonar server does not block the security-comment POC.
        stage('Sonar Scan') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    bat """
                    .\\mvnw.cmd sonar:sonar ^
                      -Dsonar.projectKey=BugDemo ^
                      -Dsonar.host.url=http://localhost:9000 ^
                      -Dsonar.login=%SONAR_TOKEN%
                    """
                }
            }
        }
    }
}
